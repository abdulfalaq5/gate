{
		"/schedule_interview/get": {
		"post": {
			"tags": ["Schedule Interview"],
			"security": [
				{
					"bearerAuth": []
				}
			],
			"summary": "Get all schedule interviews with filtering, pagination, and sorting (via request body)",
			"description": "Retrieve a paginated list of schedule interviews with all relations (candidate, company, department, title) and optional filtering via request body",
			"requestBody": {
				"required": false,
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"page": {
									"type": "integer",
									"minimum": 1,
									"default": 1,
									"description": "Page number for pagination"
								},
								"limit": {
									"type": "integer",
									"minimum": 1,
									"maximum": 100,
									"default": 10,
									"description": "Number of items per page (max 100)"
								},
								"search": {
									"type": "string",
									"description": "Search term for assign_role, schedule_interview_duration, or schedule_interview_description"
								},
								"candidate_id": {
									"type": "string",
									"format": "uuid",
									"description": "Filter by candidate ID (UUID, can be empty string, null, or omitted to get all)"
								},
								"assign_role": {
									"type": "string",
									"description": "Filter by exact assign role"
								},
								"schedule_interview_date": {
									"type": "string",
									"format": "date",
									"description": "Filter by exact schedule interview date"
								},
								"sort_by": {
									"type": "string",
									"enum": ["schedule_interview_date", "schedule_interview_time", "assign_role", "created_at", "updated_at"],
									"default": "created_at",
									"description": "Column to sort by"
								},
								"sort_order": {
									"type": "string",
									"enum": ["asc", "desc"],
									"default": "desc",
									"description": "Sort order"
								},
								"is_delete": {
									"type": "boolean",
									"default": false,
									"description": "Filter by deletion status"
								}
							}
						},
						"example": {
							"page": 1,
							"limit": 10,
							"search": "",
							"sort_by": "created_at",
							"sort_order": "desc",
							"candidate_id": ""
						}
					}
				}
			},
			"responses": {
				"200": {
					"description": "Schedule interviews retrieved successfully",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SchemaResponseScheduleInterviewCandidatesList"
							}
						}
					}
				},
				"500": {
					"description": "Internal server error"
				}
			}
		}
	},
	"/schedule_interview/create": {
		"post": {
			"tags": ["Schedule Interview"],
			"security": [
				{
					"bearerAuth": []
				}
			],
			"summary": "Create a new schedule interview",
			"description": "Create a new schedule interview with the provided information.",
			"requestBody": {
				"required": true,
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/SchemaPostScheduleInterview"
						}
					}
				}
			},
			"responses": {
				"201": {
					"description": "Schedule interview created successfully",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SchemaResponseScheduleInterview"
							}
						}
					}
				},
				"400": {
					"description": "Bad request - validation error"
				},
				"500": {
					"description": "Internal server error"
				}
			}
		}
	},
	"/schedule_interview/{id}": {
		"get": {
			"tags": ["Schedule Interview"],
			"security": [
				{
					"bearerAuth": []
				}
			],
			"description": "Retrieve a specific schedule interview by its ID with all relations (candidate, company, department, title)",
			"parameters": [
				{
					"name": "id",
					"in": "path",
					"required": true,
					"description": "Schedule Interview ID",
					"schema": {
						"type": "string",
						"format": "uuid"
					}
				}
			],
			"responses": {
				"200": {
					"description": "Schedule interview retrieved successfully",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SchemaResponseScheduleInterview"
							}
						}
					}
				},
				"404": {
					"description": "Schedule interview not found"
				},
				"500": {
					"description": "Internal server error"
				}
			}
		},
		"put": {
			"tags": ["Schedule Interview"],
			"security": [
				{
					"bearerAuth": []
				}
			],
			"description": "Update an existing schedule interview",
