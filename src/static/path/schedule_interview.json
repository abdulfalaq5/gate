				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/SchemaPutScheduleInterview"
						}
					}
				}
			},
			"responses": {
				"200": {
					"description": "Schedule interview updated successfully",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SchemaResponseScheduleInterview"
							}
						}
					}
				},
				"400": {
					"description": "Bad request - validation error"
				},
				"404": {
					"description": "Schedule interview not found"
				},
				"500": {
					"description": "Internal server error"
				}
			}
		},
		"delete": {
			"tags": ["Schedule Interview"],
			"security": [
				{
					"bearerAuth": []
				}
			],
			"description": "Soft delete a schedule interview",
			"parameters": [
				{
					"name": "id",
					"in": "path",
					"required": true,
					"description": "Schedule Interview ID",
					"schema": {
						"type": "string",
						"format": "uuid"
					}
				}
			],
			"responses": {
				"200": {
					"description": "Schedule interview deleted successfully"
				},
				"404": {
					"description": "Schedule interview not found"
				},
				"500": {
					"description": "Internal server error"
				}
			}
		}
	}
}

