	"SchemaPutCustomers": {
		"type": "object",
		"properties": {
			"customer_name": {
				"type": "string",
				"maxLength": 255,
				"description": "Customer name"
			},
			"customer_email": {
				"type": "string",
				"format": "email",
				"maxLength": 255,
				"description": "Customer email address"
			},
			"customer_phone": {
				"type": "string",
				"maxLength": 255,
				"description": "Customer phone number"
			},
			"job_title": {
				"type": "string",
				"maxLength": 255,
				"description": "Customer job title or position"
			},
			"contact_person": {
				"type": "string",
				"maxLength": 200,
