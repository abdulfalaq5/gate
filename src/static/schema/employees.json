				"type": "string",
				"format": "uuid",
				"description": "Island ID from islands table"
			},
			"employee_phone": {
				"type": "string",
				"maxLength": 50,
				"description": "Employee phone number"
			},
			"password": {
				"type": "string",
				"maxLength": 255,
				"description": "Employee password for authentication"
			},
			"employee_foto": {
				"type": "string",
				"description": "Employee photo file path stored in MinIO"
			},
			"created_at": {
				"type": "string",
				"format": "date-time"
			},
			"updated_at": {
				"type": "string",
				"format": "date-time"
			},
			"created_by": {
				"type": "string",
				"format": "uuid"
			},
			"updated_by": {
				"type": "string",
				"format": "uuid"
			},
			"deleted_at": {
				"type": "string",
				"format": "date-time"
			},
			"deleted_by": {
				"type": "string",
				"format": "uuid"
			},
			"is_delete": {
				"type": "boolean"
			}
		}
	},
	"SchemaPostEmployees": {
		"type": "object",
		"properties": {
			"employee_name": {
				"type": "string",
				"minLength": 2,
				"maxLength": 100
			},
			"employee_email": {
				"type": "string",
				"format": "email",
				"maxLength": 100
			},
			"title_id": {
				"type": "string",
				"format": "uuid"
			},
			"department_id": {
				"type": "string",
				"format": "uuid"
			},
			"gender_id": {
				"type": "string",
				"format": "uuid"
			},
			"employee_mobile": {
				"type": "string",
				"maxLength": 50
			},
			"employee_office_number": {
				"type": "string",
				"maxLength": 50
			},
			"employee_address": {
				"type": "string"
			},
			"employee_exmail_account": {
				"type": "string",
				"format": "email",
				"maxLength": 100
			},
			"employee_channel": {
				"type": "string",
				"maxLength": 100
			},
			"employee_activation_status": {
				"type": "string",
				"maxLength": 50
			},
			"employee_disabled": {
				"type": "boolean"
			},
			"employee_wechat_workplace": {
				"type": "string",
				"maxLength": 100
			},
			"island_id": {
				"type": "string",
				"format": "uuid"
			},
			"employee_phone": {
				"type": "string",
				"maxLength": 50
			},
			"password": {
				"type": "string",
				"maxLength": 255
			},
			"employee_foto": {
				"type": "string",
				"format": "binary",
				"description": "Employee photo file to upload"
			},
			"company_id": {
				"type": "string",
				"format": "uuid"
			},
			"employeeHasPermissions": {
				"type": "string",
				"description": "JSON string containing employee permissions array"
			}
		},
		"required": ["employee_name", "employee_email", "title_id"],
		"description": "company_id is optional and will be ignored during insert as it's derived from title->department->company relationship. employeeHasPermissions is optional and will create permission records for the employee."
	},
