	"SchemaPostEmployeesGet": {
		"type": "object",
		"properties": {
			"page": {
				"type": "integer",
				"default": 1,
				"minimum": 1,
				"description": "Page number for pagination"
			},
			"limit": {
				"type": "integer",
				"default": 10,
				"minimum": 1,
				"maximum": 100,
				"description": "Number of items per page (max 100)"
			},
			"search": {
				"type": "string",
				"description": "Search term for employee name or email"
			},
			"sort_by": {
				"type": "string",
				"enum": ["employee_name", "employee_email", "title_id", "created_at", "updated_at"],
				"default": "employee_name",
				"description": "Column to sort by"
			},
			"sort_order": {
				"type": "string",
				"enum": ["asc", "desc"],
				"default": "asc",
				"description": "Sort order"
			},
			"title_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by title ID"
			},
			"is_delete": {
				"type": "boolean",
				"default": false,
				"description": "Filter by deletion status"
			},
			"start_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter employees created from this date (ISO 8601 format)"
			},
			"end_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter employees created until this date (ISO 8601 format)"
			},
			"company_name": {
				"type": "string",
				"description": "Filter by company name"
			},
			"department_name": {
				"type": "string",
				"description": "Filter by department name"
			},
			"title_name": {
				"type": "string",
				"description": "Filter by title name"
			},
			"department_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by department ID"
			},
			"company_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by company ID"
			}
		},
		"example": {
			"page": 1,
			"limit": 10,
			"search": "",
			"sort_by": "employee_name",
			"sort_order": "asc",
			"title_id": "",
			"company_name": "",
			"department_name": "",
			"title_name": "",
			"department_id": "",
			"company_id": ""
		}
	},
	"SchemaResponseEmployeesList": {
		"type": "object",
		"properties": {
			"data": {
				"type": "array",
				"items": {
					"$ref": "#/components/schemas/SchemaResponseEmployees"
				}
			},
			"pagination": {
				"type": "object",
				"properties": {
					"current_page": {
						"type": "integer",
						"description": "Current page number"
					},
					"per_page": {
						"type": "integer",
						"description": "Number of items per page"
					},
					"total": {
						"type": "integer",
						"description": "Total number of records"
					},
					"total_pages": {
						"type": "integer",
						"description": "Total number of pages"
					},
					"has_next_page": {
						"type": "boolean",
						"description": "Whether there is a next page"
					},
					"has_prev_page": {
						"type": "boolean",
						"description": "Whether there is a previous page"
					}
				}
			}
		}
	},
	"SchemaPostEmployeesResetPassword": {
		"type": "object",
		"required": ["employee_id"],
		"properties": {
			"employee_id": {
				"type": "string",
				"format": "uuid",
				"description": "Employee ID to reset password"
			}
		},
		"example": {
			"employee_id": "123e4567-e89b-12d3-a456-426614174000"
		}
	},
	"SchemaResponseEmployeesResetPassword": {
		"type": "object",
		"properties": {
			"success": {
				"type": "boolean",
				"description": "Success status"
			},
			"message": {
				"type": "string",
				"description": "Response message"
			},
			"data": {
				"type": "object",
				"properties": {
					"employee_id": {
						"type": "string",
						"format": "uuid",
						"description": "Employee ID"
					},
					"employee_name": {
						"type": "string",
						"description": "Employee name"
					},
					"employee_email": {
						"type": "string",
						"format": "email",
						"description": "Employee email"
					},
					"message": {
						"type": "string",
						"description": "Reset confirmation message"
					}
				}
			},
			"timestamp": {
				"type": "string",
				"format": "date-time",
				"description": "Response timestamp"
			}
		},
		"example": {
			"success": true,
			"message": "Password reset successfully",
			"data": {
				"employee_id": "123e4567-e89b-12d3-a456-426614174000",
				"employee_name": "John Doe",
				"employee_email": "john.doe@example.com",
				"message": "Password berhasil direset"
			},
			"timestamp": "2024-01-01T00:00:00.000Z"
		}
	}
