	"SchemaUser": {
		"type": "object",
		"properties": {
			"user_id": {
				"type": "string",
				"format": "uuid",
				"description": "Unique identifier for the user"
			},
			"user_name": {
				"type": "string",
				"description": "Username of the user"
			},
			"user_email": {
				"type": "string",
				"format": "email",
				"description": "Email address of the user"
			},
			"employee_id": {
				"type": "string",
				"format": "uuid",
				"description": "Employee ID associated with the user"
			},
			"role_id": {
				"type": "string",
				"format": "uuid",
				"description": "Role ID assigned to the user"
			},
			"role_name": {
				"type": "string",
				"description": "Role name from roles table"
			},
			"created_at": {
				"type": "string",
				"format": "date-time",
				"description": "Creation timestamp"
			},
			"created_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who created this user"
			},
			"updated_at": {
				"type": "string",
				"format": "date-time",
				"nullable": true,
				"description": "Last update timestamp"
			},
			"updated_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who last updated this user"
			},
			"deleted_at": {
				"type": "string",
				"format": "date-time",
				"nullable": true,
				"description": "Soft delete timestamp"
			},
			"deleted_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who deleted this user"
			},
			"is_delete": {
				"type": "boolean",
				"description": "Soft delete flag"
			}
		}
	},
	"SchemaUsersPaginatedResponse": {
		"type": "object",
		"properties": {
			"success": {
				"type": "boolean",
				"description": "Indicates if the request was successful"
			},
			"message": {
				"type": "string",
				"description": "Response message"
			},
			"data": {
				"type": "object",
				"properties": {
					"data": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SchemaUser"
						},
						"description": "Array of user objects"
					},
					"pagination": {
						"$ref": "#/components/schemas/SchemaPaginationInfo"
					}
				}
			},
			"timestamp": {
				"type": "string",
				"format": "date-time",
				"description": "Response timestamp"
			}
		}
	},
	"SchemaCreateUser": {
		"type": "object",
		"required": ["user_name", "user_email", "user_password", "employee_id", "role_id"],
		"properties": {
			"user_name": {
				"type": "string",
				"description": "Username of the user"
			},
			"user_email": {
				"type": "string",
				"format": "email",
				"description": "Email address of the user"
			},
			"user_password": {
				"type": "string",
				"description": "Password for the user"
			},
			"employee_id": {
				"type": "string",
				"format": "uuid",
				"description": "Employee ID to associate with the user"
			},
			"role_id": {
				"type": "string",
				"format": "uuid",
				"description": "Role ID to assign to the user"
			}
		}
	},
	"SchemaPostUsersGet": {
		"type": "object",
		"properties": {
			"page": {
				"type": "integer",
				"default": 1,
				"minimum": 1,
				"description": "Page number for pagination"
			},
			"limit": {
				"type": "integer",
				"default": 10,
				"minimum": 1,
				"maximum": 100,
				"description": "Number of items per page (max 100)"
			},
			"search": {
				"type": "string",
				"description": "Search term for user name or email"
			},
			"sort_by": {
				"type": "string",
				"enum": ["user_name", "user_email", "employee_id", "role_id", "created_at", "updated_at"],
				"default": "user_name",
				"description": "Column to sort by"
			},
			"sort_order": {
				"type": "string",
				"enum": ["asc", "desc"],
				"default": "asc",
				"description": "Sort order"
			},
			"employee_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by employee ID"
			},
			"role_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by role ID"
			},
			"role_name": {
				"type": "string",
				"description": "Filter by role name"
			},
			"user_name": {
				"type": "string",
				"description": "Filter by user name"
			},
			"user_email": {
				"type": "string",
				"description": "Filter by user email"
			},
			"created_by": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by creator user ID"
			},
			"updated_by": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by updater user ID"
			},
			"is_delete": {
				"type": "boolean",
				"default": false,
				"description": "Filter by deletion status"
			},
			"start_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter users created from this date (ISO 8601 format)"
			},
			"end_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter users created until this date (ISO 8601 format)"
			},
			"employee_name": {
				"type": "string",
				"description": "Filter by employee name"
			},
			"employee_email": {
				"type": "string",
				"description": "Filter by employee email"
			},
			"role_name": {
				"type": "string",
				"description": "Filter by role name"
			}
		},
		"example": {
			"page": 1,
			"limit": 10,
			"search": "",
			"sort_by": "user_name",
			"sort_order": "asc",
			"role_id": "",
			"role_name": "",
			"user_name": "",
			"user_email": "",
			"employee_id": "",
			"employee_name": "",
			"employee_email": ""
		}
	}
