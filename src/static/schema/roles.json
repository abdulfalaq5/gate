{
	"SchemaRole": {
		"type": "object",
		"properties": {
			"role_id": {
				"type": "string",
				"format": "uuid",
				"description": "Unique identifier for the role"
			},
			"role_name": {
				"type": "string",
				"description": "Name of the role"
			},
			"role_parent_id": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "Parent role ID for hierarchical structure"
			},
			"created_at": {
				"type": "string",
				"format": "date-time",
				"description": "Creation timestamp"
			},
			"created_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who created the role"
			},
			"updated_at": {
				"type": "string",
				"format": "date-time",
				"nullable": true,
				"description": "Last update timestamp"
			},
			"updated_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who last updated the role"
			},
			"deleted_at": {
				"type": "string",
				"format": "date-time",
				"nullable": true,
				"description": "Soft delete timestamp"
			},
			"deleted_by": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "User who deleted the role"
			},
			"is_delete": {
				"type": "boolean",
				"description": "Soft delete flag"
			}
		}
	},
	"SchemaRolesPaginatedResponse": {
		"type": "object",
		"properties": {
			"success": {
				"type": "boolean",
				"description": "Indicates if the request was successful"
			},
			"message": {
				"type": "string",
				"description": "Response message"
			},
			"data": {
				"type": "object",
				"properties": {
					"data": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SchemaRole"
						},
						"description": "Array of role objects"
					},
					"pagination": {
						"$ref": "#/components/schemas/SchemaPaginationInfo"
					}
				}
			},
			"timestamp": {
				"type": "string",
				"format": "date-time",
				"description": "Response timestamp"
			}
		}
	},
	"SchemaCreateRole": {
		"type": "object",
		"required": ["role_name"],
		"properties": {
			"role_name": {
				"type": "string",
				"description": "Name of the role"
			},
			"role_parent_id": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "Parent role ID for hierarchical structure"
			}
		}
	},
	"SchemaUpdateRole": {
		"type": "object",
		"properties": {
			"role_name": {
				"type": "string",
				"description": "Name of the role"
			},
			"role_parent_id": {
				"type": "string",
				"format": "uuid",
				"nullable": true,
				"description": "Parent role ID for hierarchical structure"
			}
		}
	},
	"SchemaPostRolesGet": {
		"type": "object",
		"properties": {
			"page": {
				"type": "integer",
				"default": 1,
				"minimum": 1,
				"description": "Page number for pagination"
			},
			"limit": {
				"type": "integer",
				"default": 10,
				"minimum": 1,
				"maximum": 100,
				"description": "Number of items per page (max 100)"
			},
			"search": {
				"type": "string",
				"description": "Search term for role name"
			},
			"sort_by": {
				"type": "string",
				"enum": ["role_name", "created_at", "updated_at"],
				"default": "role_name",
				"description": "Column to sort by"
			},
			"sort_order": {
				"type": "string",
				"enum": ["asc", "desc"],
				"default": "asc",
				"description": "Sort order"
			},
			"role_name": {
				"type": "string",
				"description": "Filter by role name"
			},
			"role_parent_id": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by parent role ID"
			},
			"created_by": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by creator user ID"
			},
			"updated_by": {
				"type": "string",
				"format": "uuid",
				"description": "Filter by updater user ID"
			},
			"is_delete": {
				"type": "boolean",
				"default": false,
				"description": "Filter by deletion status"
			},
			"start_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter roles created from this date (ISO 8601 format)"
			},
			"end_date": {
				"type": "string",
				"format": "date-time",
				"description": "Filter roles created until this date (ISO 8601 format)"
			}
		},
		"example": {
			"page": 1,
			"limit": 10,
			"search": "",
			"sort_by": "role_name",
			"sort_order": "asc",
			"role_name": "",
			"role_parent_id": ""
		}
	}
