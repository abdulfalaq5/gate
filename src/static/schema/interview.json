	"SchemaPostInterview": {
		"type": "object",
		"required": ["interviews"],
		"properties": {
			"schedule_interview_id": {
				"type": "string",
				"format": "uuid",
				"description": "Schedule interview ID reference"
			},
			"interviews": {
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "object",
					"properties": {
						"company_value": {
							"type": "string",
							"maxLength": 255,
							"description": "Company value assessed in the interview",
							"example": "Integrity"
						},
						"comment": {
							"type": "string",
							"maxLength": 255,
							"description": "Comment about the interview",
							"example": "Kandidat menunjukkan kemampuan leadership yang baik."
						},
						"total_score": {
							"type": "string",
							"maxLength": 255,
							"description": "Total score of the interview",
							"example": "98"
						},
						"description": {
							"type": "string",
							"maxLength": 255,
							"description": "Description of the interview"
						},
						"detail_interviews": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"aspect": {
										"type": "string",
										"maxLength": 255,
										"description": "Aspect of the interview",
										"example": "Leadership"
									},
									"question": {
										"type": "string",
										"maxLength": 255,
										"description": "Question asked in the interview",
										"example": "Bagaimana Anda menangani konflik dalam tim?"
									},
									"answer": {
										"type": "string",
										"maxLength": 255,
										"description": "Answer given in the interview",
										"example": "Saya selalu mencoba mendengarkan semua pihak dan mencari solusi yang adil."
									},
									"score": {
										"type": "integer",
										"description": "Score for this aspect",
										"example": 85
									},
									"description": {
										"type": "string",
										"maxLength": 255,
										"description": "Description for this detail interview"
									}
								}
							}
						}
					}
				}
			}
		}
	},
